{%- style -%}
  #faq-section-{{ section.id }} {
    position: relative;
    max-width: 100%;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_vertical }}px;
    padding-bottom: {{ section.settings.padding_vertical }}px;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
    font-family: inherit;
    
    {%- if section.settings.bg_image != blank -%}
      background-image: linear-gradient(to bottom, {{ section.settings.bg_overlay_color }}, {{ section.settings.bg_overlay_color }}), url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {%- else -%}
      background-color: {{ section.settings.section_bg_color }};
    {%- endif -%}
  }

  #faq-section-{{ section.id }} .faq-inner-container {
    {%- if section.settings.full_width -%}
      max-width: 100%;
      width: 100%;
    {%- else -%}
      max-width: {{ section.settings.container_width }}px;
      width: 100%;
    {%- endif -%}
    margin: 0 auto;
  }

  #faq-section-{{ section.id }} .faq-title-area {
    margin-bottom: 45px;
    text-align: {{ section.settings.text_alignment }};
  }

  #faq-section-{{ section.id }} .faq-heading {
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  #faq-section-{{ section.id }} .faq-subheading {
    color: {{ section.settings.subheading_color }};
    font-size: 15px;
    margin: 0;
    opacity: 0.8;
  }

  #faq-section-{{ section.id }} .faq-wrapper {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap_between }}px;
  }

  /* Soft Modern Card Design */
  #faq-section-{{ section.id }} .faq-item {
    background-color: {{ section.settings.item_bg_color }};
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #faq-section-{{ section.id }} .faq-item:hover {
    border-color: rgba(0, 0, 0, 0.12);
    transform: translateY(-1px);
  }

  /* Dynamic Active Elevated State */
  #faq-section-{{ section.id }} .faq-item.is-open {
    background-color: {{ section.settings.item_active_bg_color }};
    border-color: rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
    
    {%- assign glow_opacity = section.settings.shadow_opacity | divided_by: 100.0 -%}
    box-shadow: 0 14px 34px -8px rgba(0, 0, 0, {{ glow_opacity }});
  }

  #faq-section-{{ section.id }} .faq-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: {{ section.settings.item_padding }}px;
    font-weight: 600;
    font-size: 17px;
    text-align: left;
    cursor: pointer;
    color: {{ section.settings.item_text_color }};
    gap: 20px;
    line-height: 1.4;
  }

  #faq-section-{{ section.id }} .faq-item.is-open .faq-trigger {
    color: {{ section.settings.item_active_text_color }};
  }

  /* Soft Rounded Icon Box */
  #faq-section-{{ section.id }} .faq-icon-box {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.04);
    color: {{ section.settings.item_text_color }};
    transition: all 0.3s ease;
    flex-shrink: 0;
    position: relative;
  }

  #faq-section-{{ section.id }} .faq-icon-box svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }

  #faq-section-{{ section.id }} .icon-minus {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
  }

  #faq-section-{{ section.id }} .faq-item.is-open .faq-icon-box {
    background-color: {{ section.settings.primary_color }};
    color: #ffffff;
  }

  #faq-section-{{ section.id }} .faq-item.is-open .icon-plus {
    opacity: 0;
    transform: rotate(90deg) scale(0.8);
  }

  #faq-section-{{ section.id }} .faq-item.is-open .icon-minus {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Smooth Slide Content Wrap */
  #faq-section-{{ section.id }} .faq-content-wrap {
    height: 0;
    overflow: hidden;
    transition: height 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  #faq-section-{{ section.id }} .faq-content, 
  #faq-section-{{ section.id }} .faq-content p, 
  #faq-section-{{ section.id }} .faq-content div {
    padding: 0 {{ section.settings.item_padding }}px {{ section.settings.item_padding }}px {{ section.settings.item_padding }}px;
    color: {{ section.settings.content_text_color }};
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  /* Responsive Mobile Fixes */
  @media (max-width: 767px) {
    #faq-section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top_mobile }}px !important;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px !important;
      padding-top: {{ section.settings.padding_vertical_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_vertical_mobile }}px !important;
      padding-left: {{ section.settings.padding_horizontal_mobile }}px !important;
      padding-right: {{ section.settings.padding_horizontal_mobile }}px !important;
    }
    #faq-section-{{ section.id }} .faq-trigger {
      font-size: 15px;
      padding: {{ section.settings.item_padding_mobile }}px !important;
    }
    #faq-section-{{ section.id }} .faq-content {
      font-size: 14px;
      padding: 0 {{ section.settings.item_padding_mobile }}px {{ section.settings.item_padding_mobile }}px {{ section.settings.item_padding_mobile }}px !important;
    }
  }
{%- endstyle -%}

<section id="faq-section-{{ section.id }}" class="custom-faq-js-section">
  <div class="faq-inner-container">
    <div class="faq-title-area">
      {%- if section.settings.heading != blank -%}
        <h2 class="faq-heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="faq-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="faq-wrapper">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- assign is_first_open = false -%}
          {%- if forloop.first and section.settings.open_first -%}
            {%- assign is_first_open = true -%}
          {%- endif -%}
          
          <div class="faq-item {% if is_first_open %}is-open{% endif %}" {{ block.shopify_attributes }}>
            <button class="faq-trigger" type="button" aria-expanded="{% if is_first_open %}true{% else %}false{% endif %}">
              <span>{{ block.settings.question }}</span>
              <span class="faq-icon-box">
                <!-- Plus Icon -->
                <svg class="icon-plus" viewBox="0 0 24 24">
                  <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </svg>
                <!-- Minus Icon -->
                <svg class="icon-minus" viewBox="0 0 24 24">
                  <path d="M19 13H5v-2h14v2z"/>
                </svg>
              </span>
            </button>
            <div class="faq-content-wrap" {% if is_first_open %}style="height: auto;"{% endif %}>
              <div class="faq-content">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function() {
    function initFaqAccordion(section) {
      if (!section) return;
      const items = section.querySelectorAll('.faq-item');

      items.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const contentWrap = item.querySelector('.faq-content-wrap');
        
        if (trigger.dataset.faqBound === 'true') return;
        trigger.dataset.faqBound = 'true';

        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          const isOpen = item.classList.contains('is-open');

          items.forEach(otherItem => {
            if (otherItem !== item && otherItem.classList.contains('is-open')) {
              otherItem.classList.remove('is-open');
              const otherWrap = otherItem.querySelector('.faq-content-wrap');
              otherWrap.style.height = otherWrap.scrollHeight + 'px';
              setTimeout(() => { otherWrap.style.height = '0'; }, 10);
              otherItem.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
            }
          });

          if (isOpen) {
            item.classList.remove('is-open');
            contentWrap.style.height = contentWrap.scrollHeight + 'px';
            setTimeout(() => { contentWrap.style.height = '0'; }, 10);
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            item.classList.add('is-open');
            contentWrap.style.height = contentWrap.scrollHeight + 'px';
            trigger.setAttribute('aria-expanded', 'true');
            
            contentWrap.addEventListener('transitionend', function onEnd() {
              if (item.classList.contains('is-open')) {
                contentWrap.style.height = 'auto';
              }
              contentWrap.removeEventListener('transitionend', onEnd);
            });
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      const section = document.querySelector('#faq-section-{{ section.id }}');
      initFaqAccordion(section);
    });

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.classList.contains('custom-faq-js-section') || e.target.querySelector('#faq-section-{{ section.id }}')) {
        const section = document.querySelector('#faq-section-{{ section.id }}');
        initFaqAccordion(section);
      }
    });
  })();
</script>

