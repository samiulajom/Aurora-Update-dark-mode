{{- '//cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag -}}

{%- style -%}
  /* Unique Wrapper Scope for Section {{ section.id }} */
  #shopify-section-{{ section.id }} .trending-section-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.section_side_padding }}px;
    padding-right: {{ section.settings.section_side_padding }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    background-color: {{ section.settings.section_bg }};
  }

  #shopify-section-{{ section.id }} .trending-slider-container {
    max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.container_width }}px{% endif %};
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .trending-header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .trending-section-heading {
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .trending-navigation-wrapper {
    display: flex;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .trending-swiper-button-prev,
  #shopify-section-{{ section.id }} .trending-swiper-button-next {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    width: 40px !important;
    height: 40px !important;
    background-color: {{ section.settings.arrow_bg_color }} !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer;
    transition: all 0.3s ease;
    margin: 0 !important;
  }

  /* Hide default Swiper arrows */
  #shopify-section-{{ section.id }} .trending-swiper-button-prev::after,
  #shopify-section-{{ section.id }} .trending-swiper-button-next::after {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .trending-swiper-button-prev:hover,
  #shopify-section-{{ section.id }} .trending-swiper-button-next:hover {
    background-color: {{ section.settings.arrow_hover_bg_color }} !important;
  }

  /* Custom SVG Icon Styling */
  #shopify-section-{{ section.id }} .trending-swiper-button-prev svg,
  #shopify-section-{{ section.id }} .trending-swiper-button-next svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: {{ section.settings.arrow_icon_color }};
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.3s ease;
  }

  #shopify-section-{{ section.id }} .trending-swiper-button-prev:hover svg,
  #shopify-section-{{ section.id }} .trending-swiper-button-next:hover svg {
    stroke: {{ section.settings.arrow_hover_icon_color }};
  }

  #shopify-section-{{ section.id }} .trending-swiper {
    overflow: hidden;
    padding-bottom: {% if section.settings.show_scrollbar %}40px{% else %}10px{% endif %};
  }

  #shopify-section-{{ section.id }} .trending-card {
    position: relative;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    background-color: #000;
    height: {{ section.settings.desktop_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .trending-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  #shopify-section-{{ section.id }} .trending-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  #shopify-section-{{ section.id }} .trending-card:hover .trending-image {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .trending-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.65) 100%);
    z-index: 1;
    pointer-events: none;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  #shopify-section-{{ section.id }} .trending-content {
    position: relative;
    z-index: 2;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .trending-subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
    opacity: 0.9;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .trending-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .trending-btn {
    display: inline-block;
    padding: 8px 18px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border-radius: 30px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .trending-btn:hover {
    background-color: {{ section.settings.btn_hover_bg_color }};
    color: {{ section.settings.btn_hover_text_color }};
  }

  #shopify-section-{{ section.id }} .swiper-scrollbar {
    background: #e5e5e5 !important;
    height: 4px !important;
    border-radius: 2px !important;
    position: relative !important;
    margin-top: 20px;
    {% unless section.settings.show_scrollbar %}
      display: none !important;
    {% endunless %}
  }

  #shopify-section-{{ section.id }} .swiper-scrollbar-drag {
    background: #000 !important;
    border-radius: 2px !important;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .trending-section-wrapper {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
      margin-top: {{ section.settings.mobile_margin_top }}px;
      margin-bottom: {{ section.settings.mobile_margin_bottom }}px;
    }
    #shopify-section-{{ section.id }} .trending-card {
      height: {{ section.settings.mobile_height }}px;
    }
    #shopify-section-{{ section.id }} .trending-content {
      padding: 16px;
    }
    #shopify-section-{{ section.id }} .trending-title {
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .trending-section-heading {
      font-size: 22px;
    }
  }
{%- endstyle -%}

<div class="trending-section-wrapper">
  <div class="trending-slider-container">
    
    <div class="trending-header-wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 class="trending-section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="trending-navigation-wrapper">
        <div class="trending-swiper-button-prev">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </div>
        <div class="trending-swiper-button-next">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </div>
      </div>
    </div>

    <!-- Swiper Container -->
    <div class="swiper trending-swiper" id="trending-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="trending-card">
              <div class="trending-image-wrapper">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" 
                       alt="{{ block.settings.title | escape }}" 
                       class="trending-image"
                       loading="lazy"
                       width="{{ block.settings.image.width }}"
                       height="{{ block.settings.image.height }}">
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'trending-image' }}
                {%- endif -%}
              </div>

              <div class="trending-overlay"></div>

              <div class="trending-content">
                {%- if block.settings.subtitle != blank -%}
                  <div class="trending-subtitle">{{ block.settings.subtitle }}</div>
                {%- endif -%}
                
                {%- if block.settings.title != blank -%}
                  <h3 class="trending-title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.button_text != blank -%}
                  <a href="{{ block.settings.button_link }}" class="trending-btn">
                    {{ block.settings.button_text }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Scrollbar -->
      <div class="swiper-scrollbar"></div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('#trending-swiper-{{ section.id }}', {
      slidesPerView: 1.2,
      spaceBetween: {{ section.settings.item_gap }},
      grabCursor: true,
      navigation: {
        nextEl: '#shopify-section-{{ section.id }} .trending-swiper-button-next',
        prevEl: '#shopify-section-{{ section.id }} .trending-swiper-button-prev',
      },
      scrollbar: {
        el: '#shopify-section-{{ section.id }} .swiper-scrollbar',
        draggable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: {{ section.settings.desktop_columns }},
        },
      },
    });
  });
</script>

