{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.section_side_padding }}px;
    padding-right: {{ section.settings.section_side_padding }}px;
    margin-top: {{ section.settings.margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
  }

  .section-{{ section.id }}-padding .banner-grid-container {
    max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.container_width }}px{% endif %};
    margin: 0 auto;
  }

  .section-{{ section.id }}-padding .banner-grid-wrapper {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.item_gap }}px;
    {% if section.settings.enable_overflow %}
      overflow-x: auto;
      flex-wrap: nowrap;
      display: flex;
    {% endif %}
  }

  {% if section.settings.enable_overflow %}
  .section-{{ section.id }}-padding .banner-grid-item {
    min-width: {{ section.settings.mobile_item_width }}px;
    flex: 0 0 auto;
  }
  {% endif %}

  .section-{{ section.id }}-padding .banner-grid-card {
    position: relative;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    background-color: #000;
    height: {{ section.settings.desktop_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
  }

  .section-{{ section.id }}-padding .banner-grid-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .section-{{ section.id }}-padding .banner-grid-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .section-{{ section.id }}-padding .banner-grid-card:hover .banner-grid-image {
    transform: scale(1.06);
  }

  .section-{{ section.id }}-padding .banner-grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.65) 100%);
    z-index: 1;
    pointer-events: none;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .section-{{ section.id }}-padding .banner-grid-content {
    position: relative;
    z-index: 2;
    padding: 24px;
  }

  .section-{{ section.id }}-padding .banner-grid-content .banner-grid-subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
    opacity: 0.9;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }}-padding .banner-grid-content .banner-grid-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
  }

  .section-{{ section.id }}-padding .banner-grid-btn {
    display: inline-block;
    padding: 8px 18px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border-radius: 30px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .section-{{ section.id }}-padding .banner-grid-btn:hover {
    background-color: {{ section.settings.btn_hover_bg_color }};
    color: {{ section.settings.btn_hover_text_color }};
  }

  .section-{{ section.id }}-padding .section-heading {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
      padding-left: {{ section.settings.section_side_padding_mobile }}px !important;
      padding-right: {{ section.settings.section_side_padding_mobile }}px !important;
      margin-top: {{ section.settings.margin_top_mobile | default: 0 }}px !important;
      margin-bottom: {{ section.settings.margin_bottom_mobile | default: 0 }}px !important;
    }
    .section-{{ section.id }}-padding .banner-grid-wrapper {
      grid-template-columns: repeat({% if section.settings.enable_overflow %}1{% else %}{{ section.settings.mobile_columns }}{% endif %}, minmax(0, 1fr));
      gap: {{ section.settings.item_gap_mobile }}px;
    }
    .section-{{ section.id }}-padding .banner-grid-card {
      height: {{ section.settings.mobile_height }}px;
    }
    .section-{{ section.id }}-padding .banner-grid-content {
      padding: 16px;
    }
    .section-{{ section.id }}-padding .banner-grid-content .banner-grid-title {
      font-size: 18px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" style="background-color: {{ section.settings.section_bg }};">
  <div class="banner-grid-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="banner-grid-wrapper">
      {%- for block in section.blocks -%}
        <div class="banner-grid-item" {{ block.shopify_attributes }}>
          <div class="banner-grid-card">
            <div class="banner-grid-image-wrapper">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" 
                     alt="{{ block.settings.title | escape }}" 
                     class="banner-grid-image"
                     loading="lazy"
                     width="{{ block.settings.image.width }}"
                     height="{{ block.settings.image.height }}">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'banner-grid-image' }}
              {%- endif -%}
            </div>

            <div class="banner-grid-overlay"></div>

            <div class="banner-grid-content">
              {%- if block.settings.subtitle != blank -%}
                <div class="banner-grid-subtitle">{{ block.settings.subtitle }}</div>
              {%- endif -%}
              
              {%- if block.settings.title != blank -%}
                <h3 class="banner-grid-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.button_text != blank -%}
                <a href="{{ block.settings.button_link }}" class="banner-grid-btn">
                  {{ block.settings.button_text }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Banner Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make Section Full Width",
      "default": false
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "enable_overflow",
      "label": "Enable Horizontal Scroll (Overflow)",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_item_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Scroll Item Min Width (If overflow enabled)",
      "default": 280
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 150,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Desktop Banner Height",
      "default": 280
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 120,
      "max": 450,
      "step": 10,
      "unit": "px",
      "label": "Mobile Banner Height",
      "default": 220
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Items (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Items (Mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors Control"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Button Hover Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "section_side_padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Side Padding (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_side_padding_mobile",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Side Padding (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "banner_item",
      "name": "Banner Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Waterproof Cushioning"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ACG Zegama Trail GORE-TEX"
        },
        {
          "type": "text",
          "id": "button_text",
