    }
  ],
  "presets": [
    {
      "name": "Featured Banner Grid",
      "blocks": [
        {
          "type": "banner_item",
          "settings": {
            "subtitle": "Waterproof Cushioning",
            "title": "ACG Zegama Trail GORE-TEX",
            "button_text": "Shop"
          }
        },
        {
          "type": "banner_item",
          "settings": {
            "subtitle": "",
            "title": "Pegasus Plus 2 'Crimson'",
            "button_text": "Shop Now"
          }
