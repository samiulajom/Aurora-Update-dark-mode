{%- assign s = section.settings -%}{%- assign sid = section.id -%}
{%- if s.image != blank -%}{%- assign main_img = s.image -%}{%- else -%}{%- assign main_img = s.mobile_image -%}{%- endif -%}
{%- assign img_loading = 'lazy' -%}{%- assign img_priority = 'auto' -%}
{%- if section.index == 1 -%}{%- assign img_loading = 'eager' -%}{%- assign img_priority = 'high' -%}{%- endif -%}
{%- assign alt_text = s.image_alt | default: main_img.alt -%}
{% render 'signature-hero-css', section: section %}
<div id='sig-hero-{{ sid }}' class='sig-hero sig-hero--d-{{ s.desktop_height_mode }} sig-hero--m-{{ s.mobile_height_mode }}'>
<div class='sig-hero__media'>
{%- if main_img != blank -%}
<picture>
{%- if s.image != blank and s.mobile_image != blank -%}
<source media='(max-width: 749px)' srcset='{{ s.mobile_image | image_url: width: 750 }} 750w, {{ s.mobile_image | image_url: width: 1100 }} 1100w, {{ s.mobile_image | image_url: width: 1500 }} 1500w' sizes='100vw'>
{%- endif -%}
{{ main_img | image_url: width: 2400 | image_tag: class: 'sig-hero__img', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: img_loading, fetchpriority: img_priority, alt: alt_text }}
</picture>
{%- else -%}
{{ 'hero-apparel-1' | placeholder_svg_tag: 'sig-hero__img sig-hero__placeholder' }}
{%- endif -%}
</div>
<div class='sig-hero__overlay' aria-hidden='true'></div>
{%- if s.banner_link != blank -%}<a class='sig-hero__link' href='{{ s.banner_link }}' aria-label='{{ s.banner_link_label | default: alt_text | escape }}'></a>{%- endif -%}
<div class='sig-hero__inner'><div class='sig-hero__content'>
{%- for block in section.blocks -%}
{%- assign b = block.settings -%}
{%- case block.type -%}
{%- when 'logo' -%}
{%- if b.image != blank -%}
{%- assign logo_alt = b.alt | default: b.image.alt | default: shop.name -%}
{%- capture logo_img -%}{{ b.image | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 400px, 300px', loading: 'lazy', alt: logo_alt }}{%- endcapture -%}
<div class='sig-hero__logo sig-b-{{ block.id }}' {{ block.shopify_attributes }}>{%- if b.link != blank -%}<a href='{{ b.link }}'>{{ logo_img }}</a>{%- else -%}{{ logo_img }}{%- endif -%}</div>
{%- endif -%}
{%- when 'heading' -%}
{%- if b.text != blank -%}<{{ b.tag }} class='sig-hero__heading sig-b-{{ block.id }}' {{ block.shopify_attributes }}>{{ b.text | escape }}</{{ b.tag }}>{%- endif -%}
{%- when 'text' -%}
{%- if b.text != blank -%}<div class='sig-hero__text sig-b-{{ block.id }}' {{ block.shopify_attributes }}>{{ b.text }}</div>{%- endif -%}
{%- when 'button' -%}
{%- if b.label != blank -%}<a class='sig-hero__btn sig-b-{{ block.id }}' href='{{ b.link | default: '#' }}'{% if b.new_tab %} target='_blank' rel='noopener'{% endif %} {{ block.shopify_attributes }}>{{ b.label | escape }}</a>{%- endif -%}
{%- when 'spacer' -%}
<div class='sig-hero__spacer sig-b-{{ block.id }}' aria-hidden='true' {{ block.shopify_attributes }}></div>
{%- endcase -%}
{%- endfor -%}
</div></div>
</div>

